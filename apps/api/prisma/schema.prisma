generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  CUSTOM
}
enum InputSource {
  TEXT
  TEMPLATE
  RECIPE
}
enum FoodLogStatus {
  PREVIEW
  CONFIRMED
  NEEDS_REVIEW
}
enum QuantitySource {
  EXPLICIT
  USER_PORTION_RULE
  SYSTEM_PORTION_RULE
  PROVIDER_SERVING
  CATEGORY_DEFAULT
  UNRESOLVED
}
enum NutritionBasis {
  PER_100_GRAMS
  PER_SERVING
}
enum PortionScope {
  SYSTEM
  USER
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  displayName  String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  meals        Meal[]
  inputEvents  InputEvent[]
  portionRules PortionRule[]
  recipes      Recipe[]
  templates    Template[]
  idempotencyKeys IdempotencyKey[]
}

model Meal {
  id         String       @id @default(cuid())
  userId     String
  type       MealType
  name       String?
  occurredAt DateTime
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodLogs   FoodLog[]
  @@index([userId, occurredAt])
  @@index([userId, type, occurredAt])
}

model InputEvent {
  id           String    @id @default(cuid())
  userId       String
  rawText      String
  source       InputSource
  language     String?
  parserVersion String
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  foodLog      FoodLog?
}

model FoodLog {
  id                  String          @id @default(cuid())
  mealId              String
  inputEventId        String          @unique
  status              FoodLogStatus
  totalCalories       Decimal         @db.Decimal(12, 4)
  totalProtein        Decimal         @db.Decimal(12, 4)
  totalCarbohydrates  Decimal         @db.Decimal(12, 4)
  totalFat            Decimal         @db.Decimal(12, 4)
  totalFibre          Decimal         @db.Decimal(12, 4)
  calculationVersion  String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  meal                Meal            @relation(fields: [mealId], references: [id], onDelete: Cascade)
  inputEvent          InputEvent      @relation(fields: [inputEventId], references: [id], onDelete: Restrict)
  items               FoodLogItem[]
  idempotencyKeys     IdempotencyKey[]
  @@index([mealId, createdAt])
}

model FoodLogItem {
  id                   String          @id @default(cuid())
  foodLogId            String
  foodId               String?
  rawText              String
  normalizedName       String
  preparationState     String?
  quantity             Decimal?        @db.Decimal(12, 4)
  unit                 String?
  grams                Decimal?        @db.Decimal(12, 4)
  quantitySource       QuantitySource
  assumed              Boolean
  resolutionConfidence Decimal         @db.Decimal(5, 4)
  calories             Decimal         @db.Decimal(12, 4)
  protein              Decimal         @db.Decimal(12, 4)
  carbohydrates        Decimal         @db.Decimal(12, 4)
  fat                  Decimal         @db.Decimal(12, 4)
  fibre                Decimal         @db.Decimal(12, 4)
  nutritionBasis       NutritionBasis
  provider             String?
  providerExternalId   String?
  sourceSnapshot       Json
  createdAt            DateTime        @default(now())
  foodLog              FoodLog         @relation(fields: [foodLogId], references: [id], onDelete: Cascade)
  food                 Food?           @relation(fields: [foodId], references: [id], onDelete: SetNull)
  @@index([foodLogId])
  @@index([foodId])
}

model Food {
  id                   String             @id @default(cuid())
  normalizedName       String
  preparationState     String?
  displayName          String
  category             String?
  provider             String
  providerExternalId   String
  caloriesPer100g      Decimal            @db.Decimal(12, 4)
  proteinPer100g       Decimal            @db.Decimal(12, 4)
  carbohydratesPer100g Decimal            @db.Decimal(12, 4)
  fatPer100g           Decimal            @db.Decimal(12, 4)
  fibrePer100g         Decimal            @db.Decimal(12, 4)
  rawProviderPayload    Json
  fetchedAt            DateTime
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  aliases              FoodAlias[]
  portions             FoodPortion[]
  foodLogItems         FoodLogItem[]
  portionRules         PortionRule[]
  recipeIngredients    RecipeIngredient[]
  templateItems        TemplateItem[]
  @@unique([provider, providerExternalId])
  @@index([normalizedName, preparationState])
}

model FoodAlias {
  id              String   @id @default(cuid())
  foodId          String
  alias           String
  normalizedAlias String
  createdAt       DateTime @default(now())
  food            Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)
  @@index([normalizedAlias])
}

model FoodPortion {
  id        String   @id @default(cuid())
  foodId    String
  label     String
  amount    Decimal  @db.Decimal(12, 4)
  unit      String
  grams     Decimal  @db.Decimal(12, 4)
  source    String
  createdAt DateTime @default(now())
  food      Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)
}

model PortionRule {
  id           String       @id @default(cuid())
  userId       String?
  foodId       String?
  foodCategory String?
  quantifier   String
  mealType     MealType?
  grams        Decimal      @db.Decimal(12, 4)
  scope        PortionScope
  source       String
  confidence   Decimal      @db.Decimal(5, 4)
  sampleCount  Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  food         Food?        @relation(fields: [foodId], references: [id], onDelete: Cascade)
  @@index([userId, foodId, quantifier, mealType])
}

model Recipe {
  id                  String             @id @default(cuid())
  userId              String
  name                String
  description         String?
  servingCount        Decimal            @db.Decimal(12, 4)
  totalCalories       Decimal            @db.Decimal(12, 4)
  totalProtein        Decimal            @db.Decimal(12, 4)
  totalCarbohydrates  Decimal            @db.Decimal(12, 4)
  totalFat            Decimal            @db.Decimal(12, 4)
  totalFibre          Decimal            @db.Decimal(12, 4)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredients         RecipeIngredient[]
  templateItems       TemplateItem[]
  @@unique([userId, name])
}

model RecipeIngredient {
  id               String   @id @default(cuid())
  recipeId         String
  foodId           String
  quantity         Decimal  @db.Decimal(12, 4)
  unit             String?
  grams            Decimal  @db.Decimal(12, 4)
  calories         Decimal  @db.Decimal(12, 4)
  protein          Decimal  @db.Decimal(12, 4)
  carbohydrates    Decimal  @db.Decimal(12, 4)
  fat              Decimal  @db.Decimal(12, 4)
  fibre            Decimal  @db.Decimal(12, 4)
  sourceSnapshot   Json
  position         Int
  recipe           Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  food             Food     @relation(fields: [foodId], references: [id], onDelete: Restrict)
  @@unique([recipeId, position])
}

model Template {
  id        String         @id @default(cuid())
  userId    String
  name      String
  mealType  MealType?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     TemplateItem[]
  @@unique([userId, name])
}

model TemplateItem {
  id         String    @id @default(cuid())
  templateId String
  foodId     String?
  recipeId   String?
  quantity   Decimal   @db.Decimal(12, 4)
  unit       String?
  grams      Decimal?  @db.Decimal(12, 4)
  position   Int
  template   Template  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  food       Food?     @relation(fields: [foodId], references: [id], onDelete: Restrict)
  recipe     Recipe?   @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  @@unique([templateId, position])
}

model IdempotencyKey {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  key       String
  response  Json
  createdAt DateTime @default(now())
  foodLogId String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodLog   FoodLog? @relation(fields: [foodLogId], references: [id], onDelete: SetNull)
  @@unique([userId, endpoint, key])
}
