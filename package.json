{
  "name": "semantic-calorie-tracker",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "devDependencies": {
    "@typescript-eslint/parser": "^8.33.1",
    "eslint": "^9.27.0",
    "prettier": "^3.5.3"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @calorie-tracker/api --filter @calorie-tracker/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @calorie-tracker/api prisma:migrate",
    "db:seed": "pnpm --filter @calorie-tracker/api prisma:seed",
    "db:studio": "pnpm --filter @calorie-tracker/api prisma:studio"
  }
}
